# Copy this file to .env and adjust for your environment
DEBUG=1
SECRET_KEY=please-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/simple_blog
SITE_TITLE=My Minimal Blog
SITE_TAGLINE=Writing in Markdown since 2024

# Optional post image uploads; set these only in the server environment/.env.
PEPIC_UPLOAD_URL=
PEPIC_UPLOAD_CODE=
# Optional read-only Pepic uploads directory for intrinsic image dimensions.
PEPIC_STORAGE_ROOT=
PEPIC_MEDIA_ORIGIN=https://media.subpolare.ru

# Exact HTTPS hostnames allowed for server-side map cover snapshots; no wildcards.
MAP_IMAGE_ALLOWED_HOSTS=i.subpolare.ru

# RSS stays unavailable unless explicitly enabled.
RSS_ENABLED=false

# Regional mirror: use one shared random signing key on RU and COM.
SITE_REGION=ru
GEO_REDIRECT_ENABLED=false
MIRROR_SIGNING_KEY=
MIRROR_RUNTIME=/mirror-runtime
BLOG_DATABASE_PASSWORD=
BLOG_MEDIA_PASSWORD=
